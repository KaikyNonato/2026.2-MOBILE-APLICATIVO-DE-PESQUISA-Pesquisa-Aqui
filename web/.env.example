# Copie para .env.local (desenvolvimento) ou cadastre em Vercel > Settings > Environment Variables.

# Mesmo valor do JWT_SECRET da API (o proxy.ts valida o cookie access_token com ele).
JWT_SECRET=

# Endereço da API, sem barra no final. Lido no BUILD (next.config.ts).
# Desenvolvimento: http://localhost:3001  |  Vercel: https://SUA-API.vercel.app
API_URL=http://localhost:3001
