// use prisma-next

enum CompanySituation {
    ACTIVE
    INACTIVE
}

enum UserSituation {
    ACTIVE
    INACTIVE
}

enum Profile {
  SUPERADMINISTRATOR
  ADMINISTRATOR
  RESEARCHER
}

enum ResearchStatus {
  DRAFT
  PUBLISHED
  IN_FIELD
  CLOSED
}

enum QuestionType {
  FREE_TEXT
  NUMERIC
  DATE
  TIME
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE_1_5
  PHOTO
  MULTIPLE_PHOTOS
  LOCATION
  AUDIO
}

model Company {
  id                  Int      @id @default(autoincrement())
  legalName           String
  contactInformation  String
  situation           CompanySituation @default(ACTIVE)
  // Identidade visual da empresa: endereços das imagens no Cloudinary (nulo = sem imagem).
  logoUrl             String?
  coverUrl            String?
  users               User[]
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  profile      Profile
  situation    UserSituation @default(ACTIVE)
  // Foto de perfil: endereço da imagem no Cloudinary (nulo = sem foto, o painel mostra as iniciais).
  avatarUrl    String?
  // Senha temporária (cadastro novo ou redefinição pelo administrador): a pessoa precisa trocá-la no próximo acesso.
  mustChangePassword Boolean @default(false)
  // Bloqueio temporário contra tentativas de senha: conta as falhas seguidas e, ao passar do limite, trava o login até `lockedUntil`.
  failedLoginAttempts Int @default(0)
  lockedUntil TimestamptzString?
  companyId    Int?
  company      Company?  @relation(fields: [companyId], references: [id])
  researchLinks ResearchResearcher[]
  collections  Collection[] @relation("CollectionResearcher")
  consentsConfirmed Collection[] @relation("CollectionConsentConfirmedBy")
  syncLogs     SyncLog[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Research {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  objective      String
  startDate      TimestamptzString @default(now())
  endDate        TimestamptzString @default(now())
  targetAudience String
  status         ResearchStatus   @default(DRAFT)
  recordInterview Boolean @default(false)
  // Área-alvo (círculo): coletas que começam fora dela são sinalizadas na auditoria. Tudo nulo = sem área definida.
  areaLatitude   Float?
  areaLongitude  Float?
  areaRadiusKm   Float?
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id])
  sections       Section[]
  collections    Collection[]
  questionRules  QuestionRule[]
  researchers    ResearchResearcher[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Section {
  id         Int      @id @default(autoincrement())
  title      String
  order      Int
  researchId Int
  research   Research   @relation(fields: [researchId], references: [id], onDelete: Cascade)
  questions  Question[]
  targetRules QuestionRule[] @relation("RuleTargetSection")
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}

model Question {
  id              Int              @id @default(autoincrement())
  statement       String
  type            QuestionType
  helpText        String?
  isRequired      Boolean          @default(false)
  order           Int
  sectionId       Int
  minSelections   Int?
  maxSelections   Int?
  minValue        Int?
  maxValue        Int?
  minDate         String?
  maxDate         String?
  maxLength       Int?
  scaleLeftLabel  String?
  scaleRightLabel String?
  maxFiles        Int?
  maxDuration     Int?
  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options         QuestionOption[]
  answers         Answer[]
  sourceRules     QuestionRule[]   @relation("RuleSource")
  targetRules     QuestionRule[]   @relation("RuleTarget")
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}

model QuestionOption {
  id          Int      @id @default(autoincrement())
  text        String
  order       Int
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Answer {
  id          Int      @id @default(autoincrement())
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id])
  value       String
  collectionId Int?
  collection  Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt   TimestamptzString @default(now())
}

// Uma coleta = uma entrevista feita por um pesquisador (respostas + consentimento + áudio opcional).
model Collection {
  id                   Int      @id @default(autoincrement())
  researchId           Int
  research             Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  researcherId         Int
  researcher           User     @relation("CollectionResearcher", fields: [researcherId], references: [id])
  deviceId             String?
  clientId             String?
  startedAt            TimestamptzString
  finishedAt           TimestamptzString
  receivedAt           TimestamptzString @default(now())
  // Local onde a entrevista começou (GPS do aparelho). Nulo = sem permissão, sem sinal ou coleta antiga.
  startLatitude        Float?
  startLongitude       Float?
  locationAccuracy     Float?
  consentGiven         Boolean  @default(false)
  consentAt            TimestamptzString?
  consentConfirmedById Int?
  consentConfirmedBy   User?    @relation("CollectionConsentConfirmedBy", fields: [consentConfirmedById], references: [id])
  audioPath            String?
  audioMimeType        String?
  audioSizeBytes       Int?
  audioDurationSeconds Int?
  answers              Answer[]

  // Idempotência da sincronização: o mesmo UUID do aparelho nunca grava duas coletas do mesmo pesquisador.
  @@unique([researcherId, clientId])
}

// Registro de cada envio de lote feito pelo aplicativo (aparelho, horário e resultado por coleta).
model SyncLog {
  id            Int      @id @default(autoincrement())
  researcherId  Int
  researcher    User     @relation(fields: [researcherId], references: [id])
  deviceId      String?
  receivedAt    TimestamptzString @default(now())
  totalCount    Int
  acceptedCount Int
  existingCount Int
  rejectedCount Int
  details       String
}

// Cópia ativa da pesquisa: uma linha por download (pesquisador + aparelho). Enquanto existir
// alguma com `active = true`, a estrutura do questionário fica travada (W11).
// Devolvida ou revogada, a linha NÃO é apagada: fica como histórico (quem, onde, quando, por quê).
model ResearchDownload {
  id           Int      @id @default(autoincrement())
  researchId   Int
  research     Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  deviceId     String
  userId       Int?
  active       Boolean  @default(true)
  // Data do download (e do último "atualizar" feito no mesmo aparelho).
  createdAt    TimestamptzString @default(now())
  // Devolução feita pelo próprio aparelho.
  returnedAt   TimestamptzString?
  // Revogação forçada feita pelo administrador (aparelho perdido, quebrado, pesquisador que saiu).
  revokedAt    TimestamptzString?
  revokedById  Int?
  revokeReason String?
  // Desbloqueio do aparelho pelo administrador: a revogação continua no histórico, mas o aparelho volta a poder baixar.
  unblockedAt  TimestamptzString?
  unblockedById Int?
}

model ResearchResearcher {
  id         Int      @id @default(autoincrement())
  researchId Int
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Meta de coletas deste pesquisador nesta pesquisa (ex.: 50, 120). Vazio = sem meta definida.
  targetCount Int?
  createdAt  TimestamptzString @default(now())
}

model QuestionRule {
  id               Int      @id @default(autoincrement())
  researchId       Int
  research         Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  // Condição: a resposta da questão de origem, comparada com `triggerValue` pelo `operator`
  // (EQ, NEQ, GT, GTE, LT, LTE, CONTAINS, NOT_CONTAINS, ANSWERED, NOT_ANSWERED).
  sourceQuestionId Int
  sourceQuestion   Question @relation("RuleSource", fields: [sourceQuestionId], references: [id], onDelete: Cascade)
  operator         String   @default("EQ")
  triggerValue     String
  // Alvo: uma questão OU uma seção inteira (pulo de seção). Exatamente um dos dois vem preenchido.
  targetQuestionId Int?
  targetQuestion   Question? @relation("RuleTarget", fields: [targetQuestionId], references: [id], onDelete: Cascade)
  targetSectionId  Int?
  targetSection    Section?  @relation("RuleTargetSection", fields: [targetSectionId], references: [id], onDelete: Cascade)
  // SHOW: o alvo só aparece quando a regra é verdadeira. HIDE: o alvo some quando a regra é verdadeira (pular).
  action           String   @default("SHOW")
  // Condições do mesmo alvo com a mesma `groupKey` valem em conjunto (E). Grupos diferentes valem em alternativa (OU).
  // Sem `groupKey` (regras antigas), a condição forma um grupo sozinha.
  groupKey         String?
  createdAt        TimestamptzString @default(now())
}
