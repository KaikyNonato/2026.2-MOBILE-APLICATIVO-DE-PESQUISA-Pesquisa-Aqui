# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_SECRET=

# Segurança
# Origens de navegador autorizadas a chamar a API, separadas por vírgula (ex.: https://painel.exemplo.com).
# Obrigatória em produção se algum navegador chamar a API direto; em desenvolvimento, vazio libera tudo.
# O painel web usa o caminho /api do próprio domínio e o app mobile não usa CORS, então ficam fora desta lista.
CORS_ORIGINS=
# Quantos proxies existem na frente da API (Vercel/Render = 1). Necessário para o limite de requisições enxergar o IP real.
# Deixe vazio se a API recebe conexões direto, sem proxy.
TRUST_PROXY=
# Tempo de validade do token de login (padrão 12h) e bloqueio por tentativas erradas (padrão 5 erros -> 15 minutos).
JWT_EXPIRES_IN=12h
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Senha inicial do superadministrador criado pelo `npm run seed` (vazio = gera uma aleatória e mostra no terminal).
SEED_ADMIN_PASSWORD=

# Cloudinary: onde ficam TODAS as fotos e áudios (arquivos privados, só a API os acessa).
# Pegue em Cloudinary > Dashboard > Go to API Keys. Use UMA das duas formas:
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ou, separado:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Pasta raiz no Cloudinary onde as mídias são guardadas (opcional). Cada pesquisa ganha uma subpasta própria:
# <CLOUDINARY_FOLDER>/<id da pesquisa>/... Se ficar vazio, não há pasta raiz (só <id da pesquisa>/...).
CLOUDINARY_FOLDER=

# Só para desenvolvimento SEM Cloudinary: pasta em disco (padrão: ./storage/audio)
AUDIO_STORAGE_DIR=
# Tamanho máximo do áudio de uma coleta, em bytes (padrão: 157286400 = 150 MB)
AUDIO_MAX_BYTES=
# Tamanho máximo de cada foto enviada à parte da coleta, em bytes (padrão: 31457280 = 30 MB)
PHOTO_MAX_BYTES=
