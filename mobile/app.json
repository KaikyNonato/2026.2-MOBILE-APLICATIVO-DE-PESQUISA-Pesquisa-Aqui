{
  "expo": {
    "name": "Pesquisa Aqui",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pesquisaaqui.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f4f7f5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pesquisaaqui.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#447762"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o $(PRODUCT_NAME) use o Face ID para desbloquear o aplicativo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a1410",
          "dark": {
            "backgroundColor": "#0a1410"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O aplicativo registra o local onde cada entrevista começa e a localização das questões de localização, para conferir a pesquisa no mapa depois."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O aplicativo usa a câmera para fotografar o que o pesquisador registra em campo."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O aplicativo usa o microfone para gravar a entrevista nas pesquisas que exigem gravação.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c58aacd6-b6b3-4849-99cf-52f999a49fd8"
      }
    }
  }
}
